 3.13a4 4 0 010 7.75"/></svg></span><h3>HR & operations</h3><p>Automate documents, policies and everyday admin across your teams.</p></div><div class="card"><span class="fic"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg></span><h3>Every employee</h3><p>Get more done in Word, Excel, Teams and Outlook \u2014 whatever the role.</p></div></div></div></section>\r\n\r\n<section class="training-section" id="how"><div class="wrap"><div class="sec-h"><div class="eyebrow">How it works</div><h2>From goals to hands-on in four steps</h2><p>Delivered by XcellHost, a Microsoft partner.</p></div><div class="steps"><div class="step" style="--d:0.00s"><span class="n">01</span><span class="sn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.4 1.9.7 2.8a2 2 0 01-.5 2.1L8 9.9a16 16 0 006 6l1.3-1.3a2 2 0 012.1-.4c.9.3 1.9.6 2.8.7a2 2 0 011.8 2z"/></svg></span><h3>Tell us your goals</h3><p>Share your team, roles and what you want from Copilot \u2014 adoption, a specific workflow, or a first look.</p></div><div class="step" style="--d:0.08s"><span class="n">02</span><span class="sn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span><h3>We tailor the session</h3><p>We shape the demos, prompts and scenarios to your roles and, where you like, your own tenant.</p></div><div class="step" style="--d:0.16s"><span class="n">03</span><span class="sn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span><h3>Live training day</h3><p>Expert-led demos, hands-on prompting and Q&A \u2014 your team leaves with a working prompt library.</p></div><div class="step" style="--d:0.24s"><span class="n">04</span><span class="sn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.5 9a9 9 0 0115-3.4L23 10M1 14l4.5 4.4A9 9 0 0020.5 15"/></svg></span><h3>Keep going</h3><p>Follow-up resources, Microsoft Learn paths and optional ongoing enablement to embed the habit.</p></div></div></div></section>\r\n', styles: ['/* src/app/sections/copilot-training-content.component.css */\n:host {\n  --navy:#041E42;\n  --navy2:#062A5C;\n  --blue:#1565D8;\n  --blue2:#3B82F6;\n  --sky:#8AB4FF;\n  --soft:#E8F0FD;\n  --ice:#F2F6FC;\n  --orange:#FF8C1A;\n  --orange2:#FFB15C;\n  --green:#16A34A;\n  --ink:#0B1730;\n  --mute:#5B6B85;\n  --line:#DCE5F3;\n  --font-h:"Sora",sans-serif;\n  --font-b:"IBM Plex Sans",sans-serif;\n  --font-m:"IBM Plex Mono",monospace;\n  --font-s:"Instrument Serif",serif;\n  --font-d:"Fraunces",Georgia,serif;\n  --royal:#1F5BD9;\n  --royal2:#163F9E;\n  --royal3:#0E2A66;\n  --r:16px;\n  --sh:0 10px 30px rgba(4,30,66,.08);\n  --sh2:0 22px 60px rgba(4,30,66,.16);\n}\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n:host {\n  font-family: var(--font-b);\n  color: var(--ink);\n  background: #fff;\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n}\nimg,\nsvg {\n  display: block;\n  max-width: 100%;\n}\na {\n  color: inherit;\n  text-decoration: none;\n}\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n  border: 0;\n  background: none;\n  color: inherit;\n}\nul {\n  list-style: none;\n}\n.wrap {\n  width: min(1200px, 92vw);\n  margin: 0 auto;\n}\nh1,\nh2,\nh3,\nh4 {\n  font-family: var(--font-h);\n  line-height: 1.15;\n  letter-spacing: -.01em;\n  color: var(--navy);\n}\n:focus-visible {\n  outline: 3px solid var(--oran