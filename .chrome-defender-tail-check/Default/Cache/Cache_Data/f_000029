  <section class="workflow-showcase" aria-labelledby="n8nWorkflowTitle">
    <h2 id="n8nWorkflowTitle">All about n8n \u2014 <em>watch a workflow run</em></h2>
    <p class="section-intro">n8n links apps and services so repeated tasks run on their own. Each step is a node on a visual canvas \u2014 triggers, apps, logic, code, HTTP calls and AI agents. Pick a template to see how it flows.</p>
    <div class="workflow-gallery">
      <div class="workflow-picker" role="group" aria-label="Workflow templates">
        @for (workflow of workflows; track workflow.title; let i = $index) {
          <button type="button" [class.selected]="workflowIndex() === i" [attr.aria-pressed]="workflowIndex() === i" (click)="selectWorkflow(i)"><span>{{ i + 1 }}</span>{{ workflow.title }}</button>
        }
        <button class="expert-button" type="button" (click)="consultationRequested.emit()">Talk to an expert \u2192</button>
      </div>
      <div class="workflow-canvas">
        <div class="canvas-heading"><b>{{ workflows[workflowIndex()].title }}</b><span>Canvas \xB7 live execution</span></div>
        <div class="workflow-nodes" aria-label="Workflow steps">
          @for (node of workflows[workflowIndex()].nodes; track node.label; let i = $index) {
            <div class="workflow-node" [class.active]="workflowStep() === i" [class.complete]="workflowStep() > i">
              <span class="node-icon material-symbols-outlined" aria-hidden="true">{{ node.icon }}</span>
              <small>{{ node.label }}</small>
            </div>
            @if (i < workflows[workflowIndex()].nodes.length - 1) { <span class="flow-connector" [class.lit]="workflowStep() > i" aria-hidden="true"></span> }
          }
        </div>
        <div class="workflow-status" aria-live="polite">{{ workflowMessage() }}</div>
        <button class="execute-button" type="button" [disabled]="workflowBusy()" (click)="runWorkflow()">\u25B6 Execute workflow</button>
      </div>
    </div>
  </section>

