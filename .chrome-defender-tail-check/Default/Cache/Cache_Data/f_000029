`, styles: ['/* src/app/sections/marketplace-content.component.css */\n:host {\n  --navy:#041E42;\n  --navy2:#062A5C;\n  --blue:#1565D8;\n  --blue2:#3B82F6;\n  --sky:#8AB4FF;\n  --soft:#E8F0FD;\n  --ice:#F2F6FC;\n  --orange:#FF8C1A;\n  --orange2:#FFB15C;\n  --green:#16A34A;\n  --ink:#0B1730;\n  --mute:#5B6B85;\n  --line:#DCE5F3;\n  --font-h:"Sora",sans-serif;\n  --font-b:"IBM Plex Sans",sans-serif;\n  --font-m:"IBM Plex Mono",monospace;\n  --font-s:"Instrument Serif",serif;\n  --font-d:"Fraunces",Georgia,serif;\n  --royal:#1F5BD9;\n  --royal2:#163F9E;\n  --royal3:#0E2A66;\n  --r:16px;\n  --sh:0 10px 30px rgba(4,30,66,.08);\n  --sh2:0 22px 60px rgba(4,30,66,.16);\n}\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\nimg,\nsvg {\n  display: block;\n  max-width: 100%;\n}\na {\n  color: inherit;\n  text-decoration: none;\n}\nbutton {\n  font-family: inherit;\n  cursor: pointer;\n  border: 0;\n  background: none;\n  color: inherit;\n}\nul {\n  list-style: none;\n}\n.wrap {\n  width: min(1200px, 92vw);\n  margin: 0 auto;\n}\nh1,\nh2,\nh3,\nh4 {\n  font-family: var(--font-h);\n  line-height: 1.15;\n  letter-spacing: -.01em;\n  color: var(--navy);\n}\n:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 14px 26px;\n  border-radius: 12px;\n  font: 700 15px var(--font-b);\n  position: relative;\n  overflow: hidden;\n  transition:\n    transform .25s,\n    box-shadow .25s,\n    background .25s;\n  white-space: nowrap;\n}\n.btn svg {\n  width: 16px;\n  height: 16px;\n}\n.btn-primary {\n  background:\n    linear-gradient(\n      135deg,\n      #FF9A3C,\n      #FF7A00);\n  color: #fff;\n  box-shadow: 0 10px 26px rgba(255, 140, 26, .38);\n}\n.btn-primary:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 16px 34px rgba(255, 140, 26, .5);\n}\n.btn-blue {\n  background:\n    linear-gradient(\n      135deg,\n      #2F7BEF,\n    