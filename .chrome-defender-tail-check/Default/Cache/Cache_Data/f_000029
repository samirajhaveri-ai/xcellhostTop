      i068.\u0275\u0275domElementStart(1713, "section", 320)(1714, "h2", 321);
      i068.\u0275\u0275text(1715, "Frequently Asked Questions");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1716, "div", 322)(1717, "details", 323)(1718, "summary");
      i068.\u0275\u0275text(1719, "Do you need to back up Microsoft 365?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1720, "div", 324);
      i068.\u0275\u0275text(1721, "Yes. Under Microsoft's shared responsibility model, Microsoft keeps the Microsoft 365 service available, but the data inside it \u2014 mail, files, sites and chats \u2014 is the customer's responsibility, and the Microsoft Services Agreement recommends customers regularly back up their content. Native recycle bins and retention settings keep deleted items only for limited windows that depend on the workload and licence, and they live in the same tenant as the data they protect. A third-party Microsoft 365 backup keeps independent, encrypted, immutable copies with retention you set, and restores individual items or whole users to any point in time.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1722, "details")(1723, "summary");
      i068.\u0275\u0275text(1724, "What is SaaS backup?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1725, "div", 324);
      i068.\u0275\u0275text(1726, "SaaS backup is an automated process that copies data from cloud applications like Microsoft 365 to separate, secure storage. It protects against deletion, corruption, ransomware and account compromise, and makes point-in-time recovery possible.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1727, "details")(1728, "summary");
      i068.\u0275\u0275text(1729, "What is SaaS recovery?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1730, "div", 324);
      i068.\u0275\u0275text(1731, "SaaS recovery is restoring data from those backups to its original location or a new one \u2014 a single email, a file, a site, a channel or a whole user \u2014 back to the state it was in at a chosen point in time.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1732, "details")(1733, "summary");
      i068.\u0275\u0275text(1734, "What's the difference between backup and SaaS backup?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1735, "div", 324);
      i068.\u0275\u0275text(1736, "Traditional backup protects servers, databases and files on infrastructure you manage. SaaS backup protects data that lives in cloud applications like Microsoft 365, where you don't control the underlying infrastructure but are still responsible for the data.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1737, "details")(1738, "summary");
      i068.\u0275\u0275text(1739, "How does SaaS backup protect my data?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1740, "div", 324);
      i068.\u0275\u0275text(1741, "It keeps independent, encrypted copies outside the application. If data is deleted, overwritten, encrypted by ransomware or lost to an account compromise, you restore it from a copy the incident couldn't reach.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1742, "details")(1743, "summary");
      i068.\u0275\u0275text(1744, "What types of data does Microsoft 365 backup protect?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1745, "div", 324);
      i068.\u0275\u0275text(1746, "Email, calendars and contacts in Exchange Online; files and folders in OneDrive; sites, libraries, lists and permissions in SharePoint; and teams, channels, conversations and files in Microsoft Teams.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1747, "details")(1748, "summary");
      i068.\u0275\u0275text(1749, "Which Microsoft 365 applications are supported?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1750, "div", 324);
      i068.\u0275\u0275text(1751, "Exchange Online, OneDrive, SharePoint and Microsoft Teams. For the identity layer \u2014 users, groups, roles and Conditional Access \u2014 pair it with XcellHost Entra ID Backup.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1752, "details")(1753, "summary");
      i068.\u0275\u0275text(1754, "How often is data backed up?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1755, "div", 324);
      i068.\u0275\u0275text(1756, "Automatically, several times a day by default, on a schedule we agree with you \u2014 from hourly to daily, with weekly and monthly points kept for longer-term retention.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1757, "details")(1758, "summary");
      i068.\u0275\u0275text(1759, "How easy is it to restore?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1760, "div", 324);
      i068.\u0275\u0275text(1761, "Search, pick a point in time, select the items and choose where they go. Restores don't overwrite intact data unless you ask them to, and our team will run them for you on request.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1762, "details")(1763, "summary");
      i068.\u0275\u0275text(1764, "How long is backup data retained?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1765, "div", 324);
      i068.\u0275\u0275text(1766, "As long as your policy requires \u2014 days, years or indefinitely \u2014 including previous versions and deleted items, well beyond native recycle-bin windows.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1767, "details")(1768, "summary");
      i068.\u0275\u0275text(1769, "Doesn't Microsoft already back up Microsoft 365?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1770, "div", 324);
      i068.\u0275\u0275text(1771, "Microsoft replicates data to keep the service available and offers recycle bins and retention settings, but it doesn't give you an independent, point-in-time backup you control. Under the shared responsibility model, protecting the data is the customer's job.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1772, "details")(1773, "summary");
      i068.\u0275\u0275text(1774, "Where is our backup data stored?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1775, "div", 324);
      i068.\u0275\u0275text(1776, "In encrypted, immutable storage outside your Microsoft 365 tenant. We'll confirm the storage location at onboarding so you can answer data-residency and DPDP Act questions.");
      i068.\u0275\u0275domElementEnd()();
      i068.\u0275\u0275domElementStart(1777, "details")(1778, "summary");
      i068.\u0275\u0275text(1779, "How is it priced?");
      i068.\u0275\u0275domElementEnd();
      i068.\u0275\u0275domElementStart(1780, "div", 324);
      i068.\u0275\u0275text(1781, "Per user per month, billed in INR with a GST invoice, with storage included. Bundle it with Entra ID Backup for full Microsoft 365 coverage. Ask for a quote.");
