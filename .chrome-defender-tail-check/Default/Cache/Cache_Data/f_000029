  <header class="rtx-pricing-heading">
    <span>Flexible plans for every workload</span>
    <h2 id="rtxPricingTitle">RTX 8000 Cloud GPU Plans</h2>
    <p>Select your billing period and choose the GPU configuration that fits your team. Prices start at \u20B934,900/month.</p>
  </header>

  <div class="rtx-billing-tabs" role="group" aria-label="Billing period">
    @for (term of terms; track term.label) {
      <button type="button" [class.active]="selectedTerm() === term" [attr.aria-pressed]="selectedTerm() === term" (click)="selectedTerm.set(term)">
        <span class="rtx-billing-badge">{{ term.badge }}</span>
        <span>{{ term.label }}</span>
      </button>
    }
  </div>

  <div class="rtx-plan-list">
    @for (plan of plans; track plan.code) {
      <article class="rtx-plan" [attr.data-tone]="plan.tone">
        <div class="rtx-plan-identity">
          <span class="rtx-plan-audience">{{ plan.audience }}</span>
          <div class="rtx-plan-name"><span class="rtx-gpu-count">{{ plan.gpus }}\xD7</span><div><strong>RTX 8000</strong><small>{{ plan.name }}</small></div></div>
        </div>
        <dl class="rtx-plan-specs">
          <div><dt>Server Type</dt><dd>Dedicated GPU VM</dd></div>
          <div><dt>GPU</dt><dd>{{ plan.gpus }} \xD7 48 GB</dd></div>
          <div><dt>Virtual CPU</dt><dd>{{ plan.vcpu }} vCPU</dd></div>
          <div><dt>Memory</dt><dd>{{ plan.memory }} GB</dd></div>
          <div><dt>NVMe Storage</dt><dd>{{ plan.storage }} GB</dd></div>
          <div><dt>Network Port</dt><dd>1 Gbps</dd></div>
          <div><dt>Dedicated IP</dt><dd>1</dd></div>
          <div><dt>Operating System</dt><dd>Ubuntu 22.04 / Win Server 2025</dd></div>
          <div><dt>Drivers</dt><dd>CUDA pre-installed</dd></div>
          <div><dt>Protection</dt><dd>Virtual Firewall + Anti-DDoS</dd></div>
          <div><dt>Endpoint Security</dt><dd>Acronis Cyber Protect Cloud</dd></div>
          <div><dt>Support</dt><dd>24\xD77</dd></div>
        </dl>
        <div class="rtx-plan-action">
          @if (selectedTerm().discount > 0) { <del>{{ inr(plan.monthly) }}</del> }
          <strong>{{ inr(discountedMonthly(plan)) }}</strong>
          <button type="button" (click)="requestPlan(plan)">Buy Now <span aria-hidden="true">\u2192</span></button>
          <small>+GST \xB7 {{ selectedTerm().label }} billing</small>
          <span class="rtx-hourly">\u2248 {{ inr(plan.hourly) }}/hr on demand</span>
        </div>
      </article>
    }
  </div>

  <p class="rtx-pricing-note">Indicative pricing in INR, exclusive of 18% GST. Plan codes: XG.RTX8K.1-8, XG.RTX8K.1-16, XG.RTX8K.2-32-NVL, XG.RTX8K.4-64-NVL.</p>

  <div class="rtx-estimator">
    <div class="rtx-estimator-inputs">
      <h3>Hourly or monthly? Work it out.</h3>
      <p>Tell us how much you'll actually use the GPU and we'll show the cheaper way to pay.</p>
      <label for="rtxEstimatePlan">Configuration</label>
      <select id="rtxEstimatePlan" [value]="selectedPlanIndex()" (change)="selectPlan($event)">
        @for (plan of plans; track plan.code; let index = $index) {
          <option [value]="index">{{ plan.name }} \u2014 {{ plan.gpus }}\xD7 GPU, {{ plan.vcpu }} vCPU, {{ plan.memory }} GB</option>
        }
      </select>
      <label for="rtxEstimateHours">Hours per day <output>{{ hoursPerDay() }}</output></label>
      <input id="rtxEstimateHours" type="range" min="1" max="24" [value]="hoursPerDay()" (input)="changeHours($event)" />
      <label for="rtxEstimateDays">Days per month <output>{{ daysPerMonth() }}</output></label>
      <input id="rtxEstimateDays" type="range" min="1" max="31" [value]="daysPerMonth()" (input)="changeDays($event)" />
    </div>
    <div class="rtx-estimator-results" aria-live="polite">
      <div><span>Pay-as-you-go</span><strong>{{ inr(payAsYouGo()) }}</strong></div>
      <div><span>Monthly plan</span><strong>{{ inr(monthlyPlan()) }}</strong></div>
      <div><span>1-year plan (per month)</span><strong>{{ inr(yearlyPlan()) }}</strong></div>
      <p>{{ recommendation() }}</p>
      <small>Indicative, excl. GST.</small>
    </div>
  </div>
</section>
