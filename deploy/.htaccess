# =============================================================================
#  XcellHost — Apache / Plesk configuration
#
#  Upload this file to the SAME folder as index.html (normally httpdocs).
#  It does three jobs:
#    1. sends every unknown URL to index.html so Angular's router can handle it
#    2. sets long cache lifetimes on hashed build files, and none on index.html
#    3. enables compression and a few standard security headers
#
#  If your Plesk server runs nginx rather than Apache, use nginx.conf instead.
# =============================================================================

# ----------------------------------------------------------------- 1. routing
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the site lives in a subfolder, set that here, e.g. RewriteBase /shop/
  RewriteBase /

  # Keep existing blockchain bookmarks on the renamed product URL.
  RewriteRule ^web3-(?:and-)?blockchain-infrastructure/?$ /blockchain-infrastructure/ [R=301,L]

  # Preserve paths and query strings when migrating the legacy/public www host.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?xcellhost\.(?:top|cloud)(?::\d+)?$ [NC]
  RewriteCond %{HTTP_HOST} !^xcellhost\.cloud(?::\d+)?$ [NC]
  RewriteRule ^ https://xcellhost.cloud%{REQUEST_URI} [R=301,L,NE]

  # Force HTTPS. Comment this block out until your SSL certificate is issued.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # API requests must never fall through to Angular. If an endpoint was not
  # uploaded, return a genuine 404 instead of an HTML page with status 200.
  RewriteRule ^api(?:/|$) - [L,NC]

  # Public RSS subscription URL executes PHP rather than exposing a source file.
  RewriteRule ^feeds/blog/?$ feeds/blog.php [L]

  # Blogs and use cases are published independently in the CMS. If a slug was
  # added after the latest static deployment, start Angular so it can load the
  # live CMS entry instead of returning Apache's 404 page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(?:insights|use-cases)/[^/]+/?$ index.html [L]

  # Serve real files and folders as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Every valid application URL has a prerendered file or directory. Unknown
  # paths must be genuine 404 responses rather than an Angular soft 404.
  RewriteRule ^ - [R=404,L]
</IfModule>

# Render the Angular wildcard route for unknown URLs. index.html is guaranteed
# to exist in every deployment, and Apache preserves the original 404 status
# while Angular displays the branded "page out of reach" screen.
ErrorDocument 404 /index.html

# ------------------------------------------------------------- 2. cache rules
<IfModule mod_headers.c>
  # Hashed assets (main-A1B2C3D4.js) can be cached forever — the name changes
  # whenever the content does.
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|avif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # index.html must never be cached, or visitors keep loading an old build
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <Files "llms.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>

  # ------------------------------------------------------- 3. security headers
  Header always set X-Content-Type-Options "nosniff"
  # Customer Portal Web Tabs can safely embed any XcellHost checkout. Other
  # sites remain blocked by this explicit frame-ancestor allowlist.
  Header always unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://billing.zoho.in https://billing.zohosecure.in;"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Enable once you are happy the site is HTTPS-only:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ------------------------------------------------------------- 4. compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --------------------------------------------------------------- 5. mime types
<IfModule mod_mime.c>
  AddType application/javascript          .js
  AddType text/css                        .css
  AddType image/svg+xml                   .svg
  AddType font/woff2                      .woff2
  AddType video/mp4                       .mp4
  AddType application/manifest+json       .webmanifest
  AddType text/plain                      .txt
</IfModule>

# ------------------------------------------------------------------ 6. tidying
Options -Indexes
ServerSignature Off

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
