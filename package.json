{
  "name": "xcellhost-website",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run dev -- --open",
    "build": "node scripts/generate-social-previews.js && node scripts/generate-sitemap.js && ng build",
    "postbuild": "node scripts/finalize-static-output.js",
    "build:local": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "cms:sync": "node scripts/sync-sitemap-content.cjs",
    "package": "npm run cms:sync && npm run build && node scripts/package-for-plesk.js",
    "test": "ng test",
    "test:tools": "node --test scripts/test-tools.cjs scripts/test-dns-lookup.cjs scripts/test-dns-exports.cjs scripts/test-all-dns-records.cjs scripts/test-mx-lookup.cjs scripts/test-txt-lookup.cjs scripts/test-cname-lookup.cjs scripts/test-soa-lookup.cjs scripts/test-ns-lookup.cjs scripts/test-caa-lookup.cjs scripts/test-ptr-lookup.cjs scripts/test-dnssec-check.cjs scripts/test-caa-generator.cjs scripts/test-password-generator.cjs scripts/test-hash-generator.cjs scripts/test-certificate-fingerprint.cjs scripts/test-pem-formatter.cjs scripts/test-spf-lookup.cjs scripts/test-dkim-lookup.cjs scripts/test-dmarc-lookup.cjs scripts/test-bimi-lookup.cjs scripts/test-email-dns-health.cjs scripts/test-spf-generator.cjs scripts/test-dmarc-generator.cjs scripts/test-ssh-key-generator.cjs scripts/test-ssh-fingerprint.cjs scripts/test-ssh-config.cjs scripts/test-robots-tool.cjs",
    "frontend": "node scripts/serve-with-asset-reloads.mjs",
    "ai:build": "tsc -p server/tsconfig.json",
    "ai:start": "node server/dist/index.js",
    "ai:dev": "npm run ai:build && node --watch server/dist/index.js",
    "ai:index": "npm run ai:build && node server/dist/rebuild-index.js",
    "ai:index:check": "npm run ai:build && node server/dist/rebuild-index.js --dry-run",
    "test:ai": "npm run ai:build && node --test server/tests/*.test.mjs",
    "dev": "node scripts/serve-with-asset-reloads.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p server/tsconfig.json",
    "seo:audit": "node scripts/audit-prerendered-seo.js",
    "visibility:audit": "node scripts/audit-ai-visibility.js",
    "dev:node": "npm run ai:build && node scripts/dev-with-ai.cjs",
    "test:ai:php": "php scripts/test-ai-backend.php && php scripts/test-ai-handler.php && node --test scripts/test-ai-dev-proxy.cjs",
    "test:robots:fetch": "php scripts/test-robots-fetch.php",
    "test:open-graph": "node --test scripts/test-open-graph-tool.cjs && php scripts/test-open-graph.php",
    "test:subnet": "node --test scripts/test-subnet-calculator.cjs",
    "test:web-tools": "node --test scripts/test-url-inspector.cjs scripts/test-robots-tool.cjs scripts/test-open-graph-tool.cjs && php scripts/test-robots-fetch.php && php scripts/test-open-graph.php",
    "test:ipv6": "node --test scripts/test-ipv6-tools.cjs && php scripts/test-ipv6-readiness.php",
    "test:ipv4": "node --test scripts/test-ipv4-converter.cjs",
    "test:uuid": "node --test scripts/test-uuid-generator.cjs",
    "test:api-key": "node --test scripts/test-api-key-generator.cjs",
    "test:random-string": "node --test scripts/test-random-string.cjs",
    "test:mac": "node --test scripts/test-mac-generator.cjs",
    "test:cron": "node --test scripts/test-cron-generator.cjs",
    "test:base64": "node --test scripts/test-base64-converter.cjs",
    "test:url-encode": "node --test scripts/test-url-converter.cjs",
    "test:epoch": "node --test scripts/test-epoch-converter.cjs",
    "test:json-formatter": "node --test scripts/test-json-formatter.cjs",
    "test:jwt-decoder": "node --test scripts/test-jwt-decoder.cjs",
    "test:checklists": "node --test scripts/test-checklists.cjs",
    "assets:checklists": "node scripts/generate-checklist-covers.cjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.33",
    "@angular/compiler": "^20.3.33",
    "@angular/core": "^20.3.33",
    "@angular/forms": "^20.3.33",
    "@angular/platform-browser": "^20.3.33",
    "@angular/platform-server": "^20.3.33",
    "@angular/router": "^20.3.33",
    "@angular/ssr": "^20.3.39",
    "@docsearch/css": "^5.1.2",
    "@docsearch/js": "^5.1.2",
    "@noble/hashes": "2.4.0",
    "@peculiar/x509": "3.1.0",
    "algoliasearch": "5.35.0",
    "cron-parser": "5.10.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "lottie-web": "^5.13.0",
    "material-symbols": "^0.46.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.39",
    "@angular/cli": "^20.3.39",
    "@angular/compiler-cli": "^20.3.33",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.20.5",
    "baseline-browser-mapping": "^2.11.39",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  },
  "description": "XcellHost Cloud Services — corporate website (Angular 20)"
}
